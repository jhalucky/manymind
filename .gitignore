cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
env/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Editors and operating systems
.vscode/
.idea/
.DS_Store

# Secrets and local environment
.env
.env.*
!.env.example

# Generated datasets
data/sentinel/*.csv
